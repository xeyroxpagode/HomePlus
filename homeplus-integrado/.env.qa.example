# Local/CI QA only. Copy to .env.qa; never commit the real file.
QA_FIXTURES_ENABLED=true
QA_ENVIRONMENT=qa
# Server-side only. Preferred current Supabase admin key; never expose this to Expo.
QA_SUPABASE_URL=
QA_SUPABASE_SECRET_KEY=
# Legacy compatibility only. The bootstrap rejects anon and publishable keys.
QA_SUPABASE_SERVICE_ROLE_KEY=

QA_A_EMAIL=
QA_A_PASSWORD=
QA_B_EMAIL=
QA_B_PASSWORD=
QA_C_EMAIL=
QA_C_PASSWORD=
QA_INVALID_PASSWORD=
